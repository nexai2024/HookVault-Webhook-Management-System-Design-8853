# HookVault frontend configuration.
#
# Point these at the backend in ../backend-reference to use the real API.
# If VITE_HOOKVAULT_API_URL is left blank, the app runs in MOCK MODE
# (in-memory demo data) so it works with no backend running.

VITE_HOOKVAULT_API_URL="http://localhost:4000"

# API key minted by the backend seed script (npm run db:seed) or POST /api/keys.
# Format: hv_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_HOOKVAULT_API_KEY=""
